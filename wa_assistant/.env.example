# Copy to .env and fill in real values before docker compose up

# PostgreSQL
POSTGRES_DB=wa_assistant
POSTGRES_USER=wa
POSTGRES_PASSWORD=changeme

# Redis (default config is fine for single-node dev)
# REDIS_URL is assembled inside docker-compose from service name

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Sarvam AI (https://dashboard.sarvam.ai)
SARVAM_API_KEY=...

# Your WhatsApp number in WA JID format: 91XXXXXXXXXX@s.whatsapp.net
# (country code + number, no +, no spaces)
OWNER_WA_JID=91XXXXXXXXXX@s.whatsapp.net

# Set this AFTER the first QR pair succeeds - the neonize daemon logs it on connect.
# Format: 91XXXXXXXXXX@s.whatsapp.net  (the assistant's second number)
ASSISTANT_WA_JID=

# Morning brief time in UTC (24h, colon-separated)
BRIEF_TIME_UTC=03:30

# Max Claude API spend per day in USD - pipeline skips classification above this
DAILY_COST_CEILING_USD=2.00
